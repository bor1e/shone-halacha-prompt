#!/bin/bash

echo "🔍 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

# Check if we're in a CI environment
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ] || [ -n "$TRAVIS" ] || [ -n "$CIRCLECI" ] || [ -n "$GITLAB_CI" ]; then
    echo "🚀 CI environment detected, skipping pre-push hook"
    exit 0
fi

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
    print_error "Not in the project root directory"
    exit 1
fi

# 1. Linting check
echo "📝 Running ESLint..."
if npm run lint; then
    print_status "Linting passed"
else
    print_error "Linting failed. Please fix the issues before pushing."
    exit 1
fi

# 2. TypeScript compilation check
echo "🔧 Running TypeScript compilation check..."
if npx tsc --noEmit; then
    print_status "TypeScript compilation passed"
else
    print_error "TypeScript compilation failed. Please fix the type errors before pushing."
    exit 1
fi

# 3. Unit tests
echo "🧪 Running unit tests..."
if npm test -- --watch=false; then
    print_status "Unit tests passed"
else
    print_error "Unit tests failed. Please fix the failing tests before pushing."
    exit 1
fi

# 4. Build check
echo "🏗️  Running build check..."
if npm run build; then
    print_status "Build passed"
else
    print_error "Build failed. Please fix the build issues before pushing."
    exit 1
fi

print_status "All pre-push checks passed! 🎉"
echo "You can now push your changes safely." 