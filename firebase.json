{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "secrets": [
        "GEMINI_KEY"
      ]
    }
  ],
  "hosting": {
    "public": "dist/shone-halacha-prompting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "i18n": {
      "root": "/browser"
    },
    "rewrites": [
      {
        "source": "**",
        "destination": "/browser/de/index.html"
      }
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    }
  }
}