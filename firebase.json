{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "secrets": [
        "GEMINI_KEY"
      ]
    }
  ],
  "hosting": {
    "public": "dist/shone-halacha-prompting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "i18n": {
      "root": "/browser"
    },
    "rewrites": [
      {
        "source": "/de/**",
        "destination": "/browser/de/index.html"
      },
      {
        "source": "/en/**", 
        "destination": "/browser/en/index.html"
      },
      {
        "source": "/fr/**",
        "destination": "/browser/fr/index.html"
      },
      {
        "source": "/he/**",
        "destination": "/browser/he/index.html"
      },
      {
        "source": "/ru/**",
        "destination": "/browser/ru/index.html"
      },
      {
        "source": "/",
        "destination": "/browser/de/index.html"
      },
      {
        "source": "**",
        "destination": "/browser/de/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/javascript"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Content-Type", 
            "value": "text/css"
          }
        ]
      }
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    }
  }
}