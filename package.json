{
  "name": "shone-halacha-prompting",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "serve:en": "ng serve --configuration=en",
    "serve:fr": "ng serve --configuration=fr",
    "serve:he": "ng serve --configuration=he",
    "serve:ru": "ng serve --configuration=ru",
    "build:de": "ng build --configuration production-de",
    "build:en": "ng build --configuration production-en",
    "build:fr": "ng build --configuration production-fr",
    "build:he": "ng build --configuration production-he",
    "build:ru": "ng build --configuration production-ru",
    "build:all": "./scripts/build-all.sh",
    "build:i18n": "npm run build:de && npm run build:en && npm run build:fr && npm run build:he && npm run build:ru",
    "deploy:firebase": "firebase deploy --only hosting"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.3",
    "@angular/cdk": "^20.1.3",
    "@angular/common": "^20.1.3",
    "@angular/compiler": "^20.1.3",
    "@angular/core": "^20.1.3",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.1.3",
    "@angular/localize": "^20.1.3",
    "@angular/material": "^20.1.3",
    "@angular/platform-browser": "^20.1.3",
    "@angular/platform-browser-dynamic": "^20.1.3",
    "@angular/router": "^20.1.3",
    "@types/markdown-it": "^13.0.9",
    "firebase": "^12.0.0",
    "markdown-it": "^14.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/build": "^20.1.3",
    "@angular/cli": "^20.1.3",
    "@angular/compiler-cli": "^20.1.3",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.34.1"
  }
}